<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/item_background"
    android:orientation="vertical"
    android:padding="2dp">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_item_video_comment_title_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lines="1"
        android:text="| 广州   级别:1  积分:0   注册:1小时前   视频:0   粉丝:0   关注:0"
        android:textColor="@color/item_v9porn_comment_info_text_color"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tv_item_video_comment_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:paddingLeft="3dp"
        android:text="在广州也能遇到这样的就好了 "
        android:textColor="@color/item_v9porn_comment_message_text_color"
        android:textSize="16sp"
        android:textStyle="bold" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_item_video_comment_replytime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="right"
        android:lines="1"
        android:text="(44分钟前)"
        android:textColor="@color/item_v9porn_comment_info_text_color"
        android:textSize="12sp" />
</LinearLayout>